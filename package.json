{
  "name": "familie-ks-soknad",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "start:dev": "pnpm clean && pnpm dev",
    "start:dev:lokalt-mot-preprod": "ENV=lokalt-mot-preprod pnpm start:dev",
    "dev": "pnpm dev:server",
    "dev:server": "pnpm build:backend && NODE_ENV=development node dist/backend/server.js",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc -p src/backend/tsconfig.json && node scripts/prune-backend-node-modules.js",
    "clean": "rm -rf dist",
    "hent-preprod-tokens": "node scripts/hent-preprod-tokens.js",
    "prepare": "husky",
    "test": "vitest",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "typecheck": "tsc --noEmit -p src/common/tsconfig.json && tsc --noEmit -p src/backend/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json",
    "validate": "pnpm typecheck && pnpm check"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css}": [
      "biome check"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@nais/apm": "0.6.0",
    "@navikt/aksel-icons": "8.16.1",
    "@navikt/ds-css": "8.16.1",
    "@navikt/ds-react": "8.16.1",
    "@navikt/familie-form-elements": "22.0.2",
    "@navikt/familie-http": "8.0.24",
    "@navikt/familie-logging": "7.0.8",
    "@navikt/familie-skjema": "8.2.50",
    "@navikt/familie-typer": "8.0.6",
    "@navikt/fnrvalidator": "2.2.1",
    "@navikt/nav-dekoratoren-moduler": "4.3.0",
    "@navikt/oasis": "4.1.4",
    "@portabletext/react": "7.0.1",
    "@portabletext/toolkit": "5.0.2",
    "@sanity/client": "7.26.2",
    "axios": "1.19.0",
    "classnames": "2.5.1",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "http-proxy-middleware": "4.2.0",
    "i18n-iso-countries": "7.14.0",
    "mustache-express": "1.3.2",
    "ramda": "0.32.0",
    "react": "19.2.8",
    "react-cookie": "8.1.2",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "styled-components": "6.5.2",
    "unleash-client": "6.12.0",
    "uuid": "14.0.1",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@axe-core/react": "4.12.1",
    "@biomejs/biome": "2.5.8",
    "@portabletext/types": "4.0.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/mustache-express": "1.2.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-router": "5.1.20",
    "@vercel/nft": "1.10.2",
    "@vitejs/plugin-react": "6.0.5",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "msw": "2.15.0",
    "playwright": "1.62.1",
    "ts-essentials": "10.2.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vitest-mock-extended": "5.1.1"
  }
}
