{
  "name": "familie-ks-soknad",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "start:dev": "pnpm clean && pnpm dev",
    "start:dev:lokalt-mot-preprod": "ENV=lokalt-mot-preprod pnpm start:dev",
    "dev": "pnpm dev:server",
    "dev:server": "pnpm build:backend && NODE_ENV=development node dist/backend/server.js | pino-pretty --messageKey=message",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc -p src/backend/tsconfig.json && node scripts/prune-backend-node-modules.js",
    "clean": "rm -rf dist",
    "hent-preprod-tokens": "node scripts/hent-preprod-tokens.js",
    "hent-sanity-dokumenter": "node scripts/hent-sanity-dokumenter.js",
    "prepare": "husky",
    "test": "vitest",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "check": "biome check ./src ./playwright ./playwright.config.ts",
    "check:fix": "biome check --write ./src ./playwright ./playwright.config.ts",
    "typecheck": "tsc --noEmit -p src/common/tsconfig.json && tsc --noEmit -p src/backend/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json && tsc --noEmit -p playwright/tsconfig.json",
    "validate": "pnpm typecheck && pnpm check"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css}": [
      "biome check"
    ],
    "{playwright/**/*.ts,playwright.config.ts}": [
      "biome check"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@nais/apm": "0.7.3",
    "@navikt/aksel-icons": "8.19.1",
    "@navikt/ds-css": "8.19.1",
    "@navikt/ds-react": "8.19.1",
    "@navikt/familie-form-elements": "22.0.4",
    "@navikt/familie-http": "8.0.28",
    "@navikt/familie-skjema": "8.2.54",
    "@navikt/familie-typer": "8.0.8",
    "@navikt/fnrvalidator": "2.2.1",
    "@navikt/nav-dekoratoren-moduler": "4.5.1",
    "@navikt/oasis": "4.2.2",
    "@navikt/pino-logger": "5.0.1",
    "@portabletext/react": "8.0.1",
    "@portabletext/toolkit": "6.0.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.101.4",
    "@sanity/client": "8.9.0",
    "axios": "1.20.0",
    "classnames": "2.5.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "date-fns": "4.4.0",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "http-proxy-middleware": "4.2.0",
    "i18n-iso-countries": "7.14.0",
    "mustache-express": "1.3.2",
    "pino": "10.3.1",
    "ramda": "0.32.0",
    "react": "19.3.0",
    "react-cookie": "8.1.2",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "styled-components": "6.5.3",
    "unleash-client": "6.12.2",
    "uuid": "14.0.3",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@axe-core/react": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@portabletext/types": "4.0.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/mustache-express": "1.2.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router": "5.1.20",
    "@vercel/nft": "1.11.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "msw": "3.0.3",
    "pino-pretty": "13.1.3",
    "playwright": "1.64.0",
    "ts-essentials": "10.2.1",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vitest-mock-extended": "5.1.1"
  }
}
